{
  // Type-checks everything (src + tests). Emitting is tsconfig.build.json's job.
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["chrome", "node"],
    "strict": true,
    // Sources import "./x.ts" so Node can run them directly (tests) and tsc
    // rewrites them to "./x.js" in the build.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test"]
}
